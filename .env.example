# ── SYNTHIA™ Gateway — Environment Configuration ─────────────────────────────
# Copy to .env and fill in values before running locally.
# In Coolify, set these as environment variables directly.

# ── Auth ─────────────────────────────────────────────────────────────────────
# Single gateway key — all callers use this as their "API key"
GATEWAY_API_KEY=change-me-in-production

# Optional comma-separated list of additional allowed keys
# ALLOWED_KEYS=key-for-maxx,key-for-hermes,key-for-tools

# ── Budget Circuit Breaker ───────────────────────────────────────────────────
DAILY_BUDGET_USD=10.00

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///data/synthia-gateway.db

# ── Routing ──────────────────────────────────────────────────────────────────
DEFAULT_PROVIDER=anthropic
FALLBACK_CHAIN=anthropic,openai,gemini

# ── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-20250514

# ── OpenAI ───────────────────────────────────────────────────────────────────
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com
# OPENAI_DEFAULT_MODEL=gpt-4o

# ── Google Gemini ─────────────────────────────────────────────────────────────
# GEMINI_API_KEY=AIza...
# GEMINI_DEFAULT_MODEL=gemini-2.0-flash

# ── NVIDIA NIM ───────────────────────────────────────────────────────────────
# NVIDIA_API_KEY=nvapi-...
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com

# ── Inception / Mercury 2 ────────────────────────────────────────────────────
# Not yet public. Set true + key when available.
# INCEPTION_ENABLED=false
# INCEPTION_API_KEY=

# ── z.ai ─────────────────────────────────────────────────────────────────────
# ZAI_API_KEY=
# ZAI_BASE_URL=https://api.z.ai

# ── Ollama (local) ───────────────────────────────────────────────────────────
# OLLAMA_ENABLED=false
# OLLAMA_BASE_URL=http://localhost:11434

# ── OpenRouter ───────────────────────────────────────────────────────────────
# OPENROUTER_API_KEY=sk-or-...

# ── BYOKEY ───────────────────────────────────────────────────────────────────
# BYOKEY_ENABLED=false

# ── Server ───────────────────────────────────────────────────────────────────
PORT=8018
RUST_LOG=info
